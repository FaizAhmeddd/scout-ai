# Secrets and deployment wiring only. All analysis tunables live in config/config.yaml.
APP_NAME=football-analysis-api
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=data/uploads

# Gemini agentic video analysis - get a key from Google AI Studio
GEMINI_API_KEY=

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=hf_soccer_analysis

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=720

# Demo account - created on API startup if it does not exist (leave empty to disable)
DEMO_USER_NAME=Demo Analyst
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
