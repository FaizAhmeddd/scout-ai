<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ report.target.label }} - Match Analysis</title>
<style>
  :root { --bg:#0E1117; --panel:#161B22; --line:#2A313C; --text:#E6EDF3; --muted:#8B949E; --accent:#FFE600; --team:{{ team_hex }}; --ok:#2EA043; --bad:#F85149; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--text); font:15px/1.5 "Segoe UI", system-ui, sans-serif; }
  .wrap { max-width:1280px; margin:0 auto; padding:28px 20px 60px; }
  header { display:flex; flex-wrap:wrap; justify-content:space-between; gap:16px; align-items:flex-end; border-bottom:1px solid var(--line); padding-bottom:18px; }
  h1 { margin:0; font-size:34px; letter-spacing:.5px; }
  h1 span { color:var(--accent); }
  h2 { font-size:20px; margin:42px 0 14px; padding-left:12px; border-left:4px solid var(--accent); }
  h3 { margin:0 0 8px; font-size:16px; }
  .sub { color:var(--muted); }
  .badges { display:flex; gap:8px; flex-wrap:wrap; }
  .badge { border:1px solid var(--line); border-radius:999px; padding:4px 12px; font-size:12px; color:var(--muted); background:var(--panel); }
  .badge.team { border-color:var(--team); color:var(--text); }
  .hero { display:grid; grid-template-columns:minmax(220px, 300px) 1fr; gap:24px; margin-top:26px; align-items:start; }
  .hero img.card { width:100%; filter:drop-shadow(0 12px 30px rgba(0,0,0,.6)); }
  .tiles { display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:12px; }
  .tile { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:14px 16px; }
  .tile .label { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:1px; }
  .tile .value { font-size:28px; font-weight:700; }
  .tile .note { color:var(--muted); font-size:12px; }
  video { width:100%; border-radius:12px; border:1px solid var(--line); background:#000; }
  .charts { display:grid; grid-template-columns:repeat(auto-fit, minmax(520px, 1fr)); gap:16px; }
  .chart { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:12px; }
  .chart img { width:100%; display:block; border-radius:6px; }
  .chart .cap { color:var(--muted); font-size:13px; margin:0 0 8px 4px; }
  .grid2 { display:grid; grid-template-columns:repeat(auto-fit, minmax(340px, 1fr)); gap:16px; }
  .box { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:16px 18px; }
  ul { margin:6px 0 0; padding-left:20px; }
  li { margin:4px 0; }
  .table-wrap { overflow-x:auto; }
  table { width:100%; border-collapse:collapse; background:var(--panel); border-radius:12px; overflow:hidden; }
  th, td { text-align:left; padding:9px 12px; border-bottom:1px solid var(--line); font-size:14px; }
  th { color:var(--muted); font-weight:600; text-transform:uppercase; font-size:12px; letter-spacing:.8px; }
  td.num { font-variant-numeric:tabular-nums; }
  .corner { display:grid; grid-template-columns:repeat(4, 1fr); gap:10px; margin:12px 0; }
  .corner div { background:var(--bg); border:1px solid var(--line); border-radius:10px; padding:10px; text-align:center; }
  .corner b { display:block; font-size:24px; color:var(--accent); }
  .ok { color:var(--ok); } .bad { color:var(--bad); }
  .caveats li { color:var(--muted); }
  @media (max-width: 700px) { .hero { grid-template-columns:1fr; } .charts { grid-template-columns:1fr; } .corner { grid-template-columns:repeat(2, 1fr); } }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <div class="sub">{{ mode }} &middot; {{ report.video.path.name }} &middot; {{ generated }}</div>
      <h1>{{ report.target.label }} <span>Match Analysis</span></h1>
    </div>
    <div class="badges">
      <span class="badge team">Team: {{ report.focus_team.color_name }} kit</span>
      <span class="badge">Opponent: {{ report.opponent_color }}</span>
      <span class="badge">Geometry: {{ report.geometry_mode.replace('_', ' ') }}</span>
      <span class="badge">AI events: {{ ai_status }}</span>
    </div>
  </header>

  <section class="hero" {% if not card %}style="grid-template-columns:1fr"{% endif %}>
    {% if card %}<img class="card" src="data:image/png;base64,{{ card }}" alt="Player card">{% endif %}
    <div class="tiles">
      {% for label, value, note in tiles %}
      <div class="tile"><div class="label">{{ label }}</div><div class="value">{{ value }}</div><div class="note">{{ note }}</div></div>
      {% endfor %}
    </div>
  </section>

  {% if video %}
  <h2>Annotated video</h2>
  <video src="{{ video }}" controls preload="metadata"></video>
  {% endif %}

  {% if assessment %}
  <h2>Scouting report</h2>
  <div class="box">
    <h3>{{ assessment.approximate_position }} &middot; match rating {{ '%.1f' % assessment.overall_rating_10 }}/10</h3>
    <div class="corner">
      <div><b>{{ '%.1f' % assessment.four_corner.technical }}</b>Technical</div>
      <div><b>{{ '%.1f' % assessment.four_corner.tactical }}</b>Tactical</div>
      <div><b>{{ '%.1f' % assessment.four_corner.physical }}</b>Physical</div>
      <div><b>{{ '%.1f' % assessment.four_corner.mental }}</b>Mental</div>
    </div>
    <p>{{ assessment.summary }}</p>
  </div>
  <div class="grid2" style="margin-top:16px">
    <div class="box"><h3 class="ok">Strengths</h3><ul>{% for s in assessment.strengths %}<li>{{ s }}</li>{% endfor %}</ul></div>
    <div class="box"><h3 class="bad">Areas to improve</h3><ul>{% for s in assessment.areas_to_improve %}<li>{{ s }}</li>{% endfor %}</ul></div>
  </div>
  {% endif %}

  <h2>Analysis graphs</h2>
  <div class="charts">
    {% for name, image in charts %}
    <div class="chart"><p class="cap">{{ name }}</p><img src="data:image/png;base64,{{ image }}" alt="{{ name }}"></div>
    {% endfor %}
  </div>

  {% if physical_rows or event_rows %}
  <h2>Metrics</h2>
  <div class="grid2">
    {% if physical_rows %}
    <div class="table-wrap"><table><tr><th>Physical &amp; pose (tracking)</th><th></th></tr>
      {% for k, v in physical_rows %}<tr><td>{{ k }}</td><td class="num">{{ v }}</td></tr>{% endfor %}</table></div>
    {% endif %}
    {% if event_rows %}
    <div class="table-wrap"><table><tr><th>On-ball &amp; defensive (AI events)</th><th></th></tr>
      {% for k, v in event_rows %}<tr><td>{{ k }}</td><td class="num">{{ v }}</td></tr>{% endfor %}</table></div>
    {% endif %}
  </div>
  {% endif %}

  {% if ratings %}
  <h2>How the ratings were computed</h2>
  <div class="box">
    <p class="sub">PAC = top speed + sprint frequency. PHY = distance per minute, high-intensity share, accelerations and duel win rate.
    SHO / PAS / DRI / DEF = AI-detected event rates shrunk toward typical values (so a handful of events can't produce extreme scores),
    blended with the technical assessment. Overall weights attributes by position group ({{ ratings.position_group }}) and blends in the AI match rating.
    {% if ratings.estimated %}Attributes marked * ({{ ratings.estimated|sort|join(', ') }}) had too little evidence in this clip and lean on priors.{% endif %}</p>
  </div>
  {% endif %}

  {% if team_rows %}
  <h2>Player breakdown</h2>
  <div class="table-wrap"><table>
    <tr><th>Player</th><th>On screen (s)</th><th>Distance (m)</th><th>Top speed</th><th>Sprints</th><th>High-int. (m)</th><th>Ball control (s)</th><th>PAC</th><th>PHY</th></tr>
    {% for row in team_rows %}<tr>{% for cell in row %}<td class="num">{{ cell }}</td>{% endfor %}</tr>{% endfor %}
  </table></div>
  {% endif %}

  {% if report.gemini and not assessment and report.gemini.assessments %}
  <h2>AI player assessments</h2>
  <div class="grid2">
    {% for a in report.gemini.assessments %}
    <div class="box">
      <h3>{% if a.player_jersey is not none %}#{{ a.player_jersey }} &middot; {% endif %}{{ a.approximate_position }} &middot; {{ '%.1f' % a.overall_rating_10 }}/10</h3>
      <div class="sub">{{ a.player_description }}</div>
      <p>{{ a.summary }}</p>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if report.gemini %}
  <h2>Tactical summary &amp; key moments</h2>
  <div class="box"><p>{{ report.gemini.tactical_summary }}</p>
    {% if not report.gemini.target_identified %}<p class="bad">The AI could not confidently identify the target: {{ report.gemini.identification_notes }}</p>{% endif %}
  </div>
  {% if report.gemini.key_moments %}
  <div class="table-wrap" style="margin-top:16px"><table>
    <tr><th>Time</th><th>Moment</th><th>Description</th></tr>
    {% for m in report.gemini.key_moments %}
    <tr><td class="num">{{ '%02d:%02d' % ((m.timestamp_s // 60)|int, (m.timestamp_s % 60)|int) }}</td><td>{{ m.title }}</td><td>{{ m.description }}</td></tr>
    {% endfor %}
  </table></div>
  {% endif %}
  {% endif %}

  <h2>Caveats</h2>
  <ul class="caveats">{% for c in report.caveats %}<li>{{ c }}</li>{% endfor %}</ul>
</div>
</body>
</html>
